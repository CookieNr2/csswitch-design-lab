# Copy to .env.local and fill in. src/lib/server/env.ts validates these during the
# build and when the server loads: all three are required in production; in
# development MONGODB_URI and NEXT_PUBLIC_SITE_URL fall back to the values below.
MONGODB_URI=mongodb://127.0.0.1:27017/Niiax

# Signs the session cookie. Use a long random value in production.
JWT_SECRET=change-me

# Absolute origin used for Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
